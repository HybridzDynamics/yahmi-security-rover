# ==============================================================================
# Yahmi Security Rover - Environment Configuration Template
# Copy this file to .env and customize values for your deployment
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/yahmi_security_rover
MONGODB_TEST_URI=mongodb://localhost:27017/yahmi_security_rover_test
MONGO_USERNAME=yahmi_admin
MONGO_PASSWORD=change_this_secure_mongo_password_in_prod

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_key
JWT_REFRESH_EXPIRES_IN=7d
SESSION_SECRET=replace_with_a_secure_session_secret

# Redis Cache & Message Queue
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_this_redis_password_in_prod

# Email & Alerting Notifications
EMAIL_SERVICE=gmail
EMAIL_USER=notifications@yourdomain.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=Yahmi Rover Security <noreply@yourdomain.com>
ALERT_EMAIL=security-team@yourdomain.com

# Hardware & Rover Network Configuration
DEFAULT_DEVICE_IP=192.168.1.100
DEFAULT_DEVICE_PORT=80
DEVICE_TIMEOUT=10000
ESP32_STREAM_URL=http://192.168.1.100:81/stream
RPI_STREAM_URL=http://192.168.1.101:5000/video_feed
WIFI_SSID=Yahmi-Field-Network
WIFI_PASSWORD=secure_wifi_passphrase

# AI Computer Vision Services
AI_ENABLED=true
AI_CONFIDENCE_THRESHOLD=0.5
AI_MODEL_PATH=./models/
GEMINI_API_KEY=your_gemini_api_key_here

# File Storage & Logging
MAX_FILE_SIZE=100MB
UPLOAD_PATH=uploads/
LOG_LEVEL=info
LOG_FILE=logs/yahmi.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# Rate Limiting & Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
